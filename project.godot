; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Space Commander"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://Autoload/EventBus.gd"
GData="*res://Autoload/GData.gd"
Global="*res://Autoload/Global.gd"

[debug]

event_bus/config/show_argument_names=false
event_bus/config/show_emitter_line_number=true
event_bus/config/show_receiver_line_number=false
event_bus/signals/game_started=false
